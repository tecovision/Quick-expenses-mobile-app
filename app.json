{
  "expo": {
    "name": "QuickExpenses",
    "slug": "quickexpenses",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "quickexpenses",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quickexpenses.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.QuickExpenses",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QuickExpenses to attach photos to your expense entries.",
          "cameraPermission": "Allow QuickExpenses to take photos for your expense entries.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C1C1E"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow QuickExpenses to use Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F9F9"
        }
      ],
      "expo-status-bar",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fcb188a-f028-4718-acde-bef40da9a74a"
      }
    },
    "owner": "zainydev"
  }
}
